# Optional local paths for the offline Redrob ranker.
# The CLI does not require this file and never reads hosted API credentials.

DATASET_PATH=[PUB] India_runs_data_and_ai_challenge/[PUB] India_runs_data_and_ai_challenge/India_runs_data_and_ai_challenge
DATASET_CANDIDATES_FILE=candidates.jsonl
PIPELINE_TOP_K_RESULTS=100

# Optional backend settings. See backend/.env.example for the full API config.
AI_RECRUITER_APP_ENV=development
AI_RECRUITER_DATASET_PATH=[PUB] India_runs_data_and_ai_challenge/[PUB] India_runs_data_and_ai_challenge/India_runs_data_and_ai_challenge
AI_RECRUITER_CANDIDATES_FILE=candidates.jsonl
