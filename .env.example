# Offline Redrob ranker configuration
#
# Ranking must run without hosted LLMs, hosted embeddings, or network calls.

# --- Data ---
DATASET_PATH=[PUB] India_runs_data_and_ai_challenge/[PUB] India_runs_data_and_ai_challenge/India_runs_data_and_ai_challenge
DATASET_CANDIDATES_FILE=candidates.jsonl
DATASET_CACHE_DIR=.cache
DATASET_CHUNK_SIZE=5000

# --- Pipeline ---
PIPELINE_TOP_K_RESULTS=100

# --- Local API wrapper ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
