# ==============================================================================
# AI Recruiter Brain — Environment Configuration
# ==============================================================================

# --- LLM Provider ---
# Supported: "openai" or "deepseek"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1

# DeepSeek fallback
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=candidates
QDRANT_USE_INMEMORY=false

# --- Pipeline Thresholds ---
STAGE1_TOP_K=2000
STAGE2_TOP_K=500
STAGE3_TOP_K=200
STAGE4_TOP_K=25

# --- Scoring Weights ---
WEIGHT_TECHNICAL=0.35
WEIGHT_CAREER=0.20
WEIGHT_BEHAVIORAL=0.15
WEIGHT_POTENTIAL=0.15
WEIGHT_RECRUITER=0.15

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Simulation Mode (runs without API keys) ---
SIMULATION_MODE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=recruiter_brain.log

# --- Data ---
SYNTHETIC_CANDIDATE_COUNT=100000
DATA_DIR=data
